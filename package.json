{
  "name": "mcsounds",
  "productName": "MCSOUNDS",
  "version": "1.1.0",
  "description": "Find and play all Minecraft sounds — desktop app for Windows, macOS and Linux",
  "author": {
    "name": "MCSOUNDS",
    "email": "mrdevs2011@users.noreply.github.com"
  },
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node electron/smoke.js",
    "test:packaged": "node scripts/smoke-packaged.mjs",
    "build:win": "electron-builder --win --x64 --publish never",
    "build:mac": "electron-builder --mac --x64 --arm64 --publish never",
    "build:linux": "electron-builder --linux --x64 --publish never",
    "build:desktop": "electron-builder --publish never",
    "prepare:www": "node scripts/prepare-www.mjs",
    "android:sync": "node scripts/prepare-www.mjs && npx cap sync android",
    "android:build": "cd android && ./gradlew assembleDebug"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "@capacitor/cli": "^6.2.0"
  },
  "build": {
    "appId": "com.mcsounds.app",
    "productName": "MCSOUNDS",
    "copyright": "MCSOUNDS",
    "directories": {
      "output": "dist"
    },
    "icon": "png/icon-512.png",
    "files": [
      "electron/**/*",
      "index.html",
      "css/**/*",
      "js/**/*",
      "png/**/*",
      "svg/**/*",
      "sounds/**/*",
      "sounds.json",
      "sw.js",
      "site.webmanifest",
      "favicon.ico",
      "robots.txt",
      "sitemap.xml",
      "package.json",
      "!**/.vercel/**",
      "!**/.env*",
      "!**/*.md"
    ],
    "asar": true,
    "publish": null,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-${version}-Setup.${ext}",
      "shortcutName": "MCSOUNDS",
      "uninstallDisplayName": "MCSOUNDS"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.entertainment",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "maintainer": "MCSOUNDS <mrdevs2011@users.noreply.github.com>",
      "synopsis": "Minecraft sound archive",
      "executableName": "mcsounds"
    },
    "afterPack": "scripts/adhoc-sign.js",
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "appImage": {
      "artifactName": "${productName}-${version}.${ext}"
    },
    "deb": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "asarUnpack": [
      "sounds/**/*"
    ]
  },
  "homepage": "https://minecraft-soundboard.vercel.app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrdevs2011/minecraft-soundboard.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@capacitor/core": "^6.2.0",
    "@capacitor/android": "^6.2.0"
  }
}
